# Copy to .env, replace the generated values, then run: docker compose up --build
APP_PORT=5000
FRONTEND_ORIGIN=http://localhost:5000,http://127.0.0.1:5000
FRONTEND_URL=http://localhost:5000

# Set separate random secrets (for example: openssl rand -hex 32).
MONGO_ROOT_USERNAME=fintrack-root
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=fintrack-app
MONGO_APP_PASSWORD=
JWT_SECRET=
MONGO_URI=

# Optional until email features are needed
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Razorpay settings
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
